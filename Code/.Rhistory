is.finite(price),
is.finite(bedrooms),
is.finite(review_scores_rating),
price > 0
) |>
droplevels()
required_vars <- c(
"price",
"room_type",
"bedrooms",
"review_scores_rating"
)
# 构建模型分析数据集
model_data <- listings_clean |>
select(all_of(required_vars)) |>
# 将房型设置为分类变量
mutate(
room_type = factor(room_type)
) |>
# 删除四个变量中存在缺失值的记录
drop_na() |>
# 删除无穷数及非正价格
filter(
is.finite(price),
is.finite(bedrooms),
is.finite(review_scores_rating),
price > 0
) |>
# 删除未使用的分类水平
droplevels()
# 设置整套房源作为参照组
model_data <- model_data |>
mutate(
room_type = relevel(
room_type,
ref = "Entire home/apt"
)
)
# 查看清洗前后的样本量
cat("Original sample:", nrow(listings_clean), "\n")
cat("Analysis sample:", nrow(model_data), "\n")
cat("Excluded observations:",
nrow(listings_clean) - nrow(model_data), "\n")
# 检查房型类别
levels(model_data$room_type)
# 检查模型数据结构
glimpse(model_data)
model_data |>
summarise(
n = n(),
mean_price = mean(price),
median_price = median(price),
sd_price = sd(price),
min_price = min(price),
max_price = max(price),
mean_bedrooms = mean(bedrooms),
mean_rating = mean(review_scores_rating)
) |>
kable(digits = 2)
room_summary <- model_data |>
group_by(room_type) |>
summarise(
n = n(),
mean_price = mean(price),
median_price = median(price),
sd_price = sd(price),
Q1 = quantile(price, 0.25),
Q3 = quantile(price, 0.75),
.groups = "drop"
)
room_summary |>
kable(
digits = 2,
caption = "Airbnb Prices by Room Type"
)
# 观察价格分布是否偏斜
# 特别关注高价格的右侧长尾
ggplot(model_data, aes(x = price)) +
geom_histogram(
binwidth = 20,
fill = "skyblue",
colour = "white"
) +
labs(
title = "Distribution of Airbnb Prices",
x = "Price (£)",
y = "Count"
) +
theme_minimal()
# 使用箱线图比较三种房型的价格分布
# 重点观察中位数、四分位距和离群值
ggplot(
model_data,
aes(x = room_type, y = price, fill = room_type)
) +
geom_boxplot() +
labs(
title = "Airbnb Prices by Room Type",
x = "Room Type",
y = "Price (£)"
) +
theme_minimal() +
theme(legend.position = "none")
# 卧室数量是数值型变量
# 观察卧室数量与房源价格之间的关系
ggplot(
model_data,
aes(x = bedrooms, y = price)
) +
geom_jitter(
width = 0.08,
height = 0,
alpha = 0.15
) +
# 蓝线为简单线性拟合线
geom_smooth(
method = "lm",
se = TRUE,
colour = "blue"
) +
labs(
title = "Bedrooms and Airbnb Price",
x = "Number of Bedrooms",
y = "Price (£)"
) +
theme_minimal()
# 观察住客评分与价格的线性关系
# 与之前的 Pearson 相关性分析相衔接
ggplot(
model_data,
aes(x = review_scores_rating, y = price)
) +
geom_point(alpha = 0.1) +
geom_smooth(
method = "lm",
se = TRUE,
colour = "blue"
) +
labs(
title = "Review Scores and Airbnb Prices",
x = "Review Score",
y = "Price (£)"
) +
theme_minimal()
model_1 <- lm(
price ~ room_type,
data = model_data
)
# 查看完整回归结果
summary(model_1)
# 查看各系数的95%置信区间
confint(model_1)
# 检验房型整体是否具有统计显著性
anova(model_1)
model_1 <- lm(
price ~ room_type,
data = model_data
)
# 查看完整回归结果
summary(model_1)
# 查看各系数的95%置信区间
confint(model_1)
# 检验房型整体是否具有统计显著性
anova(model_1)
# 使用四张标准诊断图
par(mfrow = c(2, 2))
plot(
model_1,
which = c(1, 2, 3, 5)
)
# 恢复默认绘图布局
par(mfrow = c(1, 1))
# 提取残差
residuals_m1 <- residuals(model_1)
# 查看残差的分布
summary(residuals_m1)
# 计算残差的标准差
sd(residuals_m1)
# 检查残差均值
mean(residuals_m1)
model_2 <- lm(
price ~ room_type +
bedrooms +
review_scores_rating,
data = model_data
)
# 查看完整回归结果
summary(model_2)
# 查看95%置信区间
confint(model_2)
drop1(
model_2,
test = "F"
)
par(mfrow = c(2, 2))
plot(
model_2,
which = c(1, 2, 3, 5)
)
par(mfrow = c(1, 1))
# 提取多元回归的残差
residuals_m2 <- residuals(model_2)
# 查看分布
summary(residuals_m2)
# 残差均值
mean(residuals_m2)
# 残差标准差
sd(residuals_m2)
# ======================================================
# 对比简单回归与多元回归的表现
# ======================================================
# R-squared:
# 解释因变量变异的比例
#
# Adjusted R-squared:
# 考虑自变量数量后的解释程度
#
# Residual SE:
# 残差标准误，单位为英镑
#
# AIC:
# 信息准则，在相同数据上通常越小越好
model_comparison <- tibble(
Model = c("M1", "M2"),
N = c(
nobs(model_1),
nobs(model_2)
),
R_squared = c(
summary(model_1)$r.squared,
summary(model_2)$r.squared
),
Adjusted_R2 = c(
summary(model_1)$adj.r.squared,
summary(model_2)$adj.r.squared
),
Residual_SE = c(
summary(model_1)$sigma,
summary(model_2)$sigma
),
AIC = c(
AIC(model_1),
AIC(model_2)
)
)
model_comparison |>
kable(digits = 4)
model_comparison <- tibble(
Model = c("M1", "M2"),
N = c(
nobs(model_1),
nobs(model_2)
),
R_squared = c(
summary(model_1)$r.squared,
summary(model_2)$r.squared
),
Adjusted_R2 = c(
summary(model_1)$adj.r.squared,
summary(model_2)$adj.r.squared
),
Residual_SE = c(
summary(model_1)$sigma,
summary(model_2)$sigma
),
AIC = c(
AIC(model_1),
AIC(model_2)
)
)
model_comparison |>
kable(digits = 4)
anova(
model_1,
model_2
)
model_data |>
group_by(room_type) |>
summarise(
n = n(),
mean_price = mean(price),
median_price = median(price),
sd_price = sd(price),
.groups = "drop"
)
ggplot(model_data,
aes(x = room_type, y = price)) +
geom_boxplot() +
labs(x = "Room Type",
y = "Price (£)") +
theme_minimal()
anova(
model_1,
model_2
)
